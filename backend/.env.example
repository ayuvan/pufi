# ============================================================
# PUFI — Environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database -----------------------------------------------------------
# SQLite for local development (default):
DATABASE_URL=sqlite:///./pufi_dev.db
# PostgreSQL example (production):
# DATABASE_URL=postgresql://pufi_user:pufi_pass@localhost:5432/pufi_dev

# Set to "true" to log SQL queries (development only)
DB_ECHO=false

# --- PayPal Sandbox -----------------------------------------------------
# Obtain from developer.paypal.com → Apps & Credentials → Your App
# NEVER use production credentials here.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET

# Configurable Sandbox Recipient Account (used if supplier has no explicit sandbox email)
# Must be a valid PayPal Sandbox personal account email (do not use placeholder addresses)
PAYPAL_SANDBOX_RECIPIENT_EMAIL=your-sandbox-account@personal.paypal.com

# --- Security & Authentication (Demo Header Check) ----------------------
# Optional API Key enforced on approval and execution endpoints:
# When set, clients must pass X-Api-Key matching this value.
# DEMO_API_KEY=your-secure-demo-key-here

# --- AI Advisory Provider ------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-3.8-flash

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins (default covers Vite dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
