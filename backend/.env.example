# ============================================================
# PUFI — Environment configuration template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database -----------------------------------------------------------
# SQLite for local development (default):
DATABASE_URL=sqlite:///./pufi_dev.db
# PostgreSQL example (switch when ready):
# DATABASE_URL=postgresql://pufi_user:pufi_pass@localhost:5432/pufi_dev

# Set to "true" to log SQL queries (development only)
DB_ECHO=false

# --- PayPal Sandbox -----------------------------------------------------
# Obtain from developer.paypal.com → Apps & Credentials → Your App
# NEVER use production credentials here.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace_me
PAYPAL_CLIENT_SECRET=replace_me

# --- AI Provider --------------------------------------------------------
# Provider name: "gemini" | "openai"
AI_PROVIDER=gemini
AI_API_KEY=replace_me
AI_MODEL=gemini-2.5-flash

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins (default covers Vite dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
