# ============================================================
# PUFI — Environment configuration template
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database -----------------------------------------------------------
DATABASE_URL=sqlite:///./pufi_dev.db
DB_ECHO=false

# --- PayPal Sandbox -----------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
PAYPAL_SANDBOX_RECIPIENT_EMAIL=your-sandbox-account@personal.paypal.com

# --- Security & Authentication (Demo Header Check) ----------------------
# DEMO_API_KEY=your-secure-demo-key-here

# --- AI Advisory Provider ------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-3.8-flash

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
