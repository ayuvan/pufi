# PUFI Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# --- Database ---
# Leave blank for SQLite dev default (backend/pufi_dev.db)
# DATABASE_URL=postgresql://pufi:secret@localhost:5432/pufi_dev

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Advisory (Gemini) ---
# Set your Gemini API key here.
# The backend uses this for advisory-only batch analysis.
# If not set, the system falls back to deterministic-only analysis.
# Obtain a key from: https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here

# Model to use — gemini-flash-latest resolves to the current stable Flash model.
# Do NOT use gemini-2.5-flash (deprecated).
AI_MODEL=gemini-flash-latest

# --- PayPal Sandbox (Day 4+) ---
# Mode MUST be "sandbox" — production mode is not supported.
# Obtain credentials from https://developer.paypal.com/dashboard/applications/sandbox
# If not set, the system operates in simulated mode (no real PayPal calls are made).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
